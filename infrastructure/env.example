# Salin ke ../.env. JANGAN commit .env. Semua nilai WAJIB diganti.

# Kata sandi PostgreSQL (acak, panjang)
POSTGRES_PASSWORD=

# Minimal 32 karakter acak:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# URL publik aplikasi (HTTPS). Dipakai untuk CORS dan tautan di email.
WEB_ORIGIN=https://nur.contoh.id
APP_BASE_URL=https://nur.contoh.id

# Produksi WAJIB SMTP (server email milik sendiri bila kebijakan zero third-party berlaku)
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://user:password@smtp.internal:587
MAIL_FROM="NUR <no-reply@nur.contoh.id>"

# Jumlah proxy tepercaya di depan API (nginx di container web = 1; tambah 1 bila ada load balancer)
TRUST_PROXY=2

AUTH_RATE_LIMIT=10
GLOBAL_RATE_LIMIT=300
