# Salin ke .env.local (jangan commit). Semua variabel VITE_* ikut ter-bundle ke browser:
# JANGAN menaruh secret apa pun di sini.

# Base URL backend NUR. Default "/api/v1" (same-origin via Nginx / proxy dev).
VITE_API_BASE_URL=/api/v1

# Target proxy untuk `npm run dev` (opsional), misalnya backend NestJS lokal.
# VITE_API_PROXY_TARGET=http://localhost:3000

# "http" (default) memakai backend NUR. "mock" memakai adapter in-memory khusus development.
# Mode mock DIABAIKAN pada build production (`vite build` mode production).
VITE_API_MODE=http
