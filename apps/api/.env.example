# Salin ke .env (jangan commit). Semua nilai di bawah adalah contoh pengembangan.
NODE_ENV=development
PORT=3000

# PostgreSQL 17:
#   docker run -d --name nur-postgres -e POSTGRES_DB=nur -e POSTGRES_USER=nur -e POSTGRES_PASSWORD=nur -p 127.0.0.1:5432:5432 postgres:17
DATABASE_URL="postgresql://nur:nur@localhost:5432/nur"

# Minimal 32 karakter acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Origin frontend (CORS + tautan email). Produksi: same-origin lewat Nginx.
WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
TRUST_PROXY=0

# Email: "log" (dev, mencetak tautan ke konsol) | "smtp" (produksi, WAJIB)
MAIL_TRANSPORT=log
MAIL_FROM="NUR <no-reply@nur.local>"
# SMTP_URL=smtp://user:pass@smtp.internal:587

# Batas permintaan per menit per IP
AUTH_RATE_LIMIT=10
GLOBAL_RATE_LIMIT=300

# Berkas media (audio) yang disajikan di /media
STORAGE_DIR=./storage
ASSET_BASE_URL=/media

# Hanya untuk `npm run seed:admin`
# SEED_ADMIN_EMAIL=admin@contoh.id
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Super Admin
