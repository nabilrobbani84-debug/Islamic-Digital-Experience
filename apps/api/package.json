{
  "name": "@nur/api",
  "version": "0.1.0",
  "private": true,
  "description": "NUR backend: NestJS 11 + Prisma 7 + PostgreSQL",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "npm run build && node dist/src/main.js",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed:admin": "node dist/scripts/seed-admin.js",
    "import:quran": "node dist/scripts/import-quran.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": ">=0.41.0 <1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "prisma": "^7.0.0",
    "supertest": "^7.0.0",
    "typescript": "~5.9.2"
  }
}
