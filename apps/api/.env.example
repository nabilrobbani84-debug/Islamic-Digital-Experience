# Salin ke .env (jangan commit .env). Untuk development lokal dengan Docker:
#   docker run -d --name nur-postgres -e POSTGRES_DB=nur -e POSTGRES_USER=nur_user \
#     -e POSTGRES_PASSWORD=dev_password -p 127.0.0.1:5432:5432 postgres:17
DATABASE_URL="postgresql://nur_user:dev_password@localhost:5432/nur?schema=public"
